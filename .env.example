# Copy to .env and fill in. Never commit .env.

# Camera sources: webcam index (0, 1, ...) or IP-camera stream URL
AISS_CAM1=0
AISS_CAM2=http://192.168.1.104:8080/video

AISS_FRAME_SIZE=640x480

# Detection: motion (classic), hybrid (motion + neural-net person check, default)
# or person (neural net every few frames, also catches people standing still)
AISS_DETECTOR=hybrid
AISS_PERSON_CONFIDENCE=0.45
AISS_FPS=20
AISS_FOOTAGE_DIR=footage
AISS_INTRUSIONS_DIR=intrusions

# Twilio SMS alerts (optional - alerts are logged to the console if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
